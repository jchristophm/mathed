{
  "name": "@jchristophm/mathed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "docs", "examples"],
  "exports": { ".": { "types": "./dist/mathed.d.ts", "import": "./dist/mathed.js" }, "./style.css": "./dist/style.css" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --config vite.package.config.ts && tsc -p tsconfig.package.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "katex": "^0.16.22" },
  "devDependencies": {
    "@playwright/test": "1.56.1", "@types/katex": "^0.16.7",
    "typescript": "^5.9.3", "vite": "^6.4.1", "vitest": "^3.2.4", "ajv": "^8.17.1"
  }
}
